{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "projects": {
    "IdentityAdministration.Web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": [
              "node_modules/@fontsource/barlow/400.css",
              "node_modules/@fontsource/barlow/500.css",
              "node_modules/@fontsource/barlow/600.css",
              "node_modules/@fontsource/barlow/700.css",
              "node_modules/@fontsource/barlow-condensed/600.css",
              "node_modules/@fontsource/barlow-condensed/700.css",
              "node_modules/@fontsource/ibm-plex-mono/400.css",
              "src/theme/dx-theme-light.css",
              "src/theme/dx-theme-dark.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3.5MB",
                  "maximumError": "4.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.json" },
          "configurations": {
            "development": {
              "buildTarget": "IdentityAdministration.Web:build:development"
            },
            "production": {
              "buildTarget": "IdentityAdministration.Web:build:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": { "runnerConfig": "vitest-base.config.ts" }
        }
      }
    }
  }
}
