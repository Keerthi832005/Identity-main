{
  "name": "identity-administration.web",
  "version": "0.1.17",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4300",
    "start:local": "node --use-system-ca ./node_modules/@angular/cli/bin/ng.js serve --host localhost --port 4301 --proxy-config proxy.local-iis.json",
