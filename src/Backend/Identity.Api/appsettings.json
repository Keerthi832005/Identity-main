{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "RateLimit": {
      "AuthenticationPermitLimit": 10,
      "SessionRefreshPermitLimit": 30,
      "SessionLogoutPermitLimit": 30
    },
    "BrowserSession": {
      "CookieName": "__Secure-identity-refresh",
      "CookiePath": "/identity",
      "RequireSecureCookie": true
    }
  },
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "AllowedHosts": "*"
}
